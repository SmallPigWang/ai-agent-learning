# ============================================================
# API Key 配置模板 —— 复制为 .env 并填入真实 Key
# .env 已被 .gitignore 排除，切勿提交到 GitHub！
# 获取方式:
#   DeepSeek:  https://platform.deepseek.com
#   Claude:    https://console.anthropic.com（需海外支付方式）
#   jiekou 中转: https://jiekou.vip（大陆直连 Claude，支付宝充值）
# ============================================================

# DeepSeek API Key（阶段 1.3 起使用）
DEEPSEEK_API_KEY=sk-你的key放这里

# Anthropic 官方 API Key（可选，有海外支付方式时用）
ANTHROPIC_API_KEY=sk-ant-api03-你的key放这里

# jiekou 中转 API Key（大陆调用 Claude 的方案）
JIEKOU_API_KEY=sk_你的key放这里

# jiekou 中转 base_url（OpenAI 兼容格式）
JIEKOU_BASE_URL=https://api.highwayapi.ai/openai/v1
